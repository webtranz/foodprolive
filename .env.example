PORT=3000
HOST=0.0.0.0
DATABASE_INIT_ATTEMPTS=30
DATABASE_INIT_DELAY_MS=2000
PUBLIC_APP_URL=https://foodpro.example.com
BULK_UPLOAD_MAX_MB=25
GENERAL_UPLOAD_MAX_MB=25
BULK_UPLOAD_BATCH_SIZE=500
BULK_UPLOAD_WORKERS=1

DATABASE_URL=postgresql://foodpro:foodpro@postgres:5432/foodpro
# Use a direct PostgreSQL or PgBouncer session endpoint for LISTEN/NOTIFY.
REALTIME_DATABASE_URL=postgresql://foodpro:foodpro@postgres:5432/foodpro
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=foodpro
POSTGRES_USER=foodpro
POSTGRES_PASSWORD=foodpro
POSTGRES_SSL=false
DB_APPLICATION_NAME=foodpro-api
DB_POOL_MAX=20
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_POOL_CONNECTION_TIMEOUT_MS=5000
DB_POOL_MAX_LIFETIME_SECONDS=1800
DB_STATEMENT_TIMEOUT_MS=15000
DB_QUERY_TIMEOUT_MS=20000
SITE_SCOPE_CACHE_TTL_MS=10000
ROLE_PROFILE_CACHE_TTL_MS=10000
COSTING_CATALOG_CACHE_TTL_MS=10000
MANAGEMENT_DASHBOARD_SOURCE_PAGE_SIZE=5000
MANAGEMENT_DASHBOARD_MAX_SOURCE_ROWS=250000
MANAGEMENT_DASHBOARD_CACHE_TTL_MS=5000
MANAGEMENT_DASHBOARD_CACHE_MAX_ENTRIES=1024
BULK_UPLOAD_QUEUE_POLL_MS=2000
BULK_UPLOAD_STALE_AFTER_MS=900000

# Configure an S3-compatible service for shared files when the API runs on multiple hosts.
# Leave OBJECT_STORAGE_ENDPOINT empty to use the local uploads directory in development.
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=foodpro
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_SESSION_TOKEN=
OBJECT_STORAGE_FORCE_PATH_STYLE=true
# Optional HTTPS CDN/public bucket base, for example https://files.example.com/foodpro
OBJECT_STORAGE_PUBLIC_URL=

